        <PAGEOBJECT XPOS="1038.26871653543" YPOS="124.88288976378" OwnPage="0" ItemID="547129862" PTYPE="4" WIDTH="206.929133858268" HEIGHT="62.3622047244095" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR2="Black" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L206.929 0 L206.929 62.3622 L0 62.3622 L0 0 Z" copath="M0 0 L206.929 0 L206.929 62.3622 L0 62.3622 L0 0 Z" gXpos="1038.26871653543" gYpos="124.88288976378" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
