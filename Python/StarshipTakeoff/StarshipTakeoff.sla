        </PAGEOBJECT>
        <PAGEOBJECT XPOS="716.769361108344" YPOS="1471.20721618659" OwnPage="-1" ItemID="553236070" PTYPE="2" WIDTH="319.52497741061" HEIGHT="170.07874015748" FRTYPE="0" CLIPEDIT="0" ROT="359" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.185878404543694" LOCALSCY="0.185878404543694" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="StarshipTakeoff-end.png" IRENDER="0" EMBEDDED="0" path="M0 0 L319.525 0 L319.525 170.079 L0 170.079 L0 0 Z" copath="M0 0 L319.525 0 L319.525 170.079 L0 170.079 L0 0 Z" gXpos="716.769361108344" gYpos="1471.20721618659" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="145.355330708659" YPOS="1176.85139370078" OwnPage="1" ItemID="560809942" PTYPE="4" WIDTH="504.566929133858" HEIGHT="99.2125984251969" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="Green" SHADE="10" PCOLOR2="Black" PLINEART="15" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="2.83464566929134" TEXTRA="2.83464566929134" BEXTRA="2.83464566929134" REXTRA="2.83464566929134" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L504.567 0 L504.567 99.2126 L0 99.2126 L0 0 Z" copath="M0 0 L504.567 0 L504.567 99.2126 L0 99.2126 L0 0 Z" gXpos="740.630921259842" gYpos="294.961629921261" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Lexend Black" CH="What is mass?"/>
                <para PARENT="Paragraph"/>
                <ITEXT FONT="Lexend Black" CH="Mass"/>
                <ITEXT CH=" tells us how much stuff something is made of. A spaceship with more mass is harder to launch than one with less mass."/>
                <para PARENT="Paragraph"/>
                <ITEXT FONT="Lexend Black" CH="Gravity"/>
                <ITEXT CH=" also matters. Stronger gravity pulls the spaceship down more strongly."/>
                <para PARENT="Paragraph"/>
                <ITEXT CH="The "/>
                <ITEXT FONT="Lexend Black" CH="force"/>
                <ITEXT CH=" is the push from the spaceship's engines and it is worked out as:"/>
                <para PARENT="Paragraph"/>
                <tab/>
                <ITEXT CH="force = gravity × mass"/>
                <para PARENT="Paragraph"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="144.185590850194" YPOS="1535.22974185189" OwnPage="1" ItemID="560926582" PTYPE="2" WIDTH="99.2125984251969" HEIGHT="142.541557305337" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.0510352872557596" LOCALSCY="0.0510352872557596" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="computer-spacegames-cover.png" PRFILE="Embedded GIMP built-in sRGB" IRENDER="0" EPROF="Embedded GIMP built-in sRGB" path="M0 0 L99.2126 0 L99.2126 142.542 L0 142.542 L0 0 Z" copath="M0 0 L99.2126 0 L99.2126 142.542 L0 142.542 L0 0 Z" gXpos="144.185590850194" gYpos="1535.22974185189" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
