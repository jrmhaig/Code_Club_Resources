            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="1066.61517322835" YPOS="674.804149606301" OwnPage="0" ItemID="552649734" PTYPE="4" WIDTH="178.582677165354" HEIGHT="138.897637795276" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="Cyan" SHADE="10" PCOLOR2="Black" PLINEART="6" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="2.83464566929134" TEXTRA="2.83464566929134" BEXTRA="2.83464566929134" REXTRA="2.83464566929134" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L178.583 0 L178.583 138.898 L0 138.898 L0 0 Z" copath="M0 0 L178.583 0 L178.583 138.898 L0 138.898 L0 0 Z" gXpos="1066.61517322835" gYpos="674.804149606301" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="secret = 7"/>
                <para PARENT="Code"/>
                <para PARENT="Code"/>
                <ITEXT CH="for attempt in range(10):"/>
                <para PARENT="Code"/>
                <ITEXT CH="    guess = int(input(&quot;&gt; &quot;))"/>
                <para PARENT="Code"/>
                <ITEXT CH="    if guess &lt; secret:"/>
                <para PARENT="Code"/>
                <ITEXT CH="        print(&quot;Too low!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="    elif guess &gt; secret:"/>
                <para PARENT="Code"/>
                <ITEXT CH="        print(&quot;Too high!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="    else:"/>
                <para PARENT="Code"/>
                <ITEXT CH="        print(&quot;Correct!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="        break"/>
                <para PARENT="Code"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="746.30021259842" YPOS="762.678165354334" OwnPage="0" ItemID="552550230" PTYPE="4" WIDTH="314.645669291339" HEIGHT="53.8582677165354" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="Green" SHADE="10" PCOLOR2="Black" PLINEART="15" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="2.83464566929134" TEXTRA="2.83464566929134" BEXTRA="2.83464566929134" REXTRA="2.83464566929134" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L314.646 0 L314.646 53.8583 L0 53.8583 L0 0 Z" copath="M0 0 L314.646 0 L314.646 53.8583 L0 53.8583 L0 0 Z" gXpos="746.300212598424" gYpos="762.678165354334" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="for"/>
                <ITEXT CH=" loop repeats the code to ask for a guess 10 times but if the player guesses correctly then the "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="break"/>
                <ITEXT CH=" command stops the loop immediately."/>
                <para PARENT="Paragraph"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.686039370077" YPOS="1281.73328346457" OwnPage="1" ItemID="552702662" PTYPE="4" WIDTH="515.905511811024" HEIGHT="240.944881889764" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR2="Black" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.906 0 L515.906 240.945 L0 240.945 L0 0 Z" copath="M0 0 L515.906 0 L515.906 240.945 L0 240.945 L0 0 Z" gXpos="139.686039370077" gYpos="399.843519685038" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Finally, to make the game more interesting, the gravity and mass will be chosen randomly."/>
                <para PARENT="Paragraph"/>
                <ITEXT CH="The gravity and mass are chosen randomly using the "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="randrange"/>
                <ITEXT CH=" function from the random "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="library"/>
                <ITEXT CH="."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="Also, add a message if the player gets caught by the aliens. To check this we need a new variable, "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="launched"/>
                <ITEXT CH=", that is "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="False"/>
                <ITEXT CH=" when the spaceship is on the ground and "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="True"/>
                <ITEXT CH=" when the player managed to take off."/>
                <para PARENT="Bullet"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.686039370075" YPOS="1278.89863775858" OwnPage="1" ItemID="552807270" PTYPE="6" WIDTH="36.8504000000004" HEIGHT="31.1811000734027" FRTYPE="0" CLIPEDIT="0" PWIDTH="1.00000017094018" PLINEART="1" TEXTFLOWMODE="1" path="M0 0 L36.8504 0 L36.8504 31.1811 L0 31.1811 L0 0 Z" copath="M0 0 L36.8504 0 L36.8504 31.1811 L0 31.1811 L0 0 Z" gXpos="-595.275590551181" gYpos="337.822834645668" gWidth="36.8503937007874" gHeight="32.1811023622047" LAYER="0"/>
        <PAGEOBJECT XPOS="142.520685523923" YPOS="1278.89863775858" OwnPage="1" ItemID="552804310" PTYPE="4" WIDTH="31.181107692308" HEIGHT="31.1811000734027" FRTYPE="0" CLIPEDIT="0" PWIDTH="1.00000017094018" PCOLOR="White" PCOLOR2="Black" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L31.1811 0 L31.1811 31.1811 L0 31.1811 L0 0 Z" copath="M0 0 L31.1811 0 L31.1811 31.1811 L0 31.1811 L0 0 Z" gXpos="-592.440944881888" gYpos="337.822834645669" gWidth="36.8503937007874" gHeight="32.1811023622047" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONTSIZE="24" CH="5"/>
                <trail PARENT="Number"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="366.457692913377" YPOS="1298.74115748032" OwnPage="1" ItemID="553107366" PTYPE="4" WIDTH="286.299212598425" HEIGHT="257.952755905512" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="Cyan" SHADE="10" PCOLOR2="Black" PLINEART="6" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="2.83464566929134" TEXTRA="2.83464566929134" BEXTRA="2.83464566929134" REXTRA="2.83464566929134" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286.299 0 L286.299 257.953 L0 257.953 L0 0 Z" copath="M0 0 L286.299 0 L286.299 257.953 L0 257.953 L0 0 Z" gXpos="366.457692913381" gYpos="416.851393700787" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="from random import randrange"/>
                <para PARENT="New Code"/>
                <para PARENT="Code"/>
                <ITEXT CH="gravity = randrange(1, 20)"/>
                <para PARENT="New Code"/>
                <ITEXT CH="mass = randrange(1, 40)"/>
                <para PARENT="New Code"/>
                <ITEXT CH="required_force = gravity * mass"/>
                <para PARENT="Code"/>
                <ITEXT CH="launched = False"/>
                <para PARENT="New Code"/>
                <ITEXT CH="print(&quot;Gravity is&quot;, gravity)"/>
                <para PARENT="Code"/>
                <para PARENT="Code"/>
                <ITEXT CH="for attempt in range(10):"/>
                <para PARENT="Code"/>
                <ITEXT CH="    force = int(input(&quot;Enter launch force: &quot;))"/>
                <para PARENT="Code"/>
                <ITEXT CH="    if force &lt; required_force:"/>
                <para PARENT="Code"/>
                <ITEXT CH="        print(&quot;Too low!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="    elif force &gt; required_force:"/>
                <para PARENT="Code"/>
                <ITEXT CH="        print(&quot;Too high!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="    else:"/>
                <para PARENT="Code"/>
                <ITEXT CH="        print(&quot;Well done! You took off!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="        launched = True"/>
                <para PARENT="New Code"/>
                <ITEXT CH="        break"/>
                <para PARENT="Code"/>
                <para PARENT="Code"/>
                <ITEXT CH="if not launched:"/>
                <para PARENT="New Code"/>
                <ITEXT CH="    print(&quot;Bad luck! The aliens caught you!&quot;)"/>
                <para PARENT="New Code"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="386.300212598425" YPOS="1672.91438582678" OwnPage="1" ItemID="552988806" PTYPE="4" WIDTH="269.291338582677" HEIGHT="31.1811023622047" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L269.291 0 L269.291 31.1811 L0 31.1811 L0 0 Z" copath="M0 0 L269.291 0 L269.291 31.1811 L0 31.1811 L0 0 Z" gXpos="386.300212598425" gYpos="1672.91438582677" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
