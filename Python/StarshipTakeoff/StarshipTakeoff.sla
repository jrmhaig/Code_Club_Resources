            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="For the very first version, make a very easy guessing game. This is very easy because the number to guess is always the same!"/>
                <para PARENT="Paragraph"/>
                <ITEXT CH="Set the secret variable to 7 (or some other number)."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="Let the player guess."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="Check if the player has guessed correctly."/>
                <para PARENT="Bullet"/>
            </StoryText>
        </PAGEOBJECT>
