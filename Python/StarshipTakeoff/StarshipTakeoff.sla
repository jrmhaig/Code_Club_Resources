        <PAGEOBJECT XPOS="1092.12698425197" YPOS="414.016748031496" OwnPage="0" ItemID="547388118" PTYPE="4" WIDTH="153.070866141732" HEIGHT="90.7086614173228" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="Cyan" SHADE="10" PCOLOR2="Black" PLINEART="6" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="2.83464566929134" TEXTRA="2.83464566929134" BEXTRA="2.83464566929134" REXTRA="2.83464566929134" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L153.071 0 L153.071 90.7087 L0 90.7087 L0 0 Z" copath="M0 0 L153.071 0 L153.071 90.7087 L0 90.7087 L0 0 Z" gXpos="1092.12698425197" gYpos="414.016748031496" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="secret = 7"/>
                <para PARENT="Code"/>
                <para PARENT="Code"/>
                <ITEXT CH="guess = int(input(&quot;&gt; &quot;))"/>
                <para PARENT="Code"/>
                <ITEXT CH="if guess == secret:"/>
                <para PARENT="Code"/>
                <ITEXT CH="    print(&quot;Correct!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="else:"/>
                <para PARENT="Code"/>
                <ITEXT CH="    print(&quot;Wrong!&quot;)"/>
                <para PARENT="Code"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="737.796275590546" YPOS="507.56005511811" OwnPage="0" ItemID="551359878" PTYPE="4" WIDTH="510.236220472441" HEIGHT="172.913385826772" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="Green" SHADE="10" PCOLOR2="Black" PLINEART="15" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="2.83464566929134" TEXTRA="2.83464566929134" BEXTRA="2.83464566929134" REXTRA="2.83464566929134" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L510.236 0 L510.236 172.913 L0 172.913 L0 0 Z" copath="M0 0 L510.236 0 L510.236 172.913 L0 172.913 L0 0 Z" gXpos="737.79627559055" gYpos="507.56005511811" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Lexend Bold" CH="Note:"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="input(&quot;&gt; &quot;)"/>
                <ITEXT CH=" lets the user enter a guess but what is "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="int"/>
                <ITEXT CH=" there for?"/>
                <para PARENT="Paragraph"/>
                <ITEXT CH="In a computer program there are different types of variable and it is important to make sure that they do not get mixed up."/>
                <para PARENT="Paragraph"/>
                <ITEXT CH="The "/>
                <ITEXT FONT="Courier New Regular" CH="input"/>
                <ITEXT CH=" function returns a "/>
                <ITEXT FONT="Lexend Black" CH="string"/>
                <ITEXT CH=" of characters so the user can enter "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="&quot;123&quot;"/>
                <ITEXT CH=" and could also enter "/>
                <ITEXT FONT="Courier New Regular" CH="&quot;word&quot;"/>
                <ITEXT CH="."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="An "/>
                <ITEXT FONT="Lexend Black" CH="integer"/>
                <ITEXT CH=" is a whole number and in the code above "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="secret"/>
                <ITEXT CH=" is an integer variable."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="To test "/>
                <ITEXT FONT="Courier New Regular" CH="guess"/>
                <ITEXT CH=" with "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="secret"/>
                <ITEXT CH=" they need to both be the same type of variable. The "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="int"/>
                <ITEXT CH=" function changes a string into an integer."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="Later on there will be another variable type called a "/>
                <ITEXT FONT="Lexend Black" CH="boolean"/>
                <ITEXT CH=" that is always true or false. Can you spot it?"/>
                <para PARENT="Bullet"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.686039370079" YPOS="944.410413936357" OwnPage="1" ItemID="551494534" PTYPE="4" WIDTH="515.905511811024" HEIGHT="226.771653543307" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PCOLOR2="Black" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.906 0 L515.906 226.772 L0 226.772 L0 0 Z" copath="M0 0 L515.906 0 L515.906 226.772 L0 226.772 L0 0 Z" gXpos="734.96162992126" gYpos="62.5206501568362" gWidth="515.905511811024" gHeight="76.5346324611132" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="So far this is just a number guessing game. Lets add the space theme and make the number to guess a little more complicated."/>
                <para PARENT="Paragraph"/>
                <ITEXT CH="Set the "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="gravity"/>
                <ITEXT CH=" of the planet the player is trapped on. The player knows what the gravity is."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="Then set the "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="mass"/>
                <ITEXT CH=" of the spaceship. The mass is unknown to the player."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="The "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="required_force"/>
                <ITEXT CH=" that the player needs to use is then the gravity times mass. This is the number to guess instead of the "/>
                <ITEXT FONT="Courier 10 Pitch Regular" CH="secret"/>
                <ITEXT CH="."/>
                <para PARENT="Bullet"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.686039370077" YPOS="941.575798451778" OwnPage="1" ItemID="551795830" PTYPE="6" WIDTH="36.8504000000004" HEIGHT="31.1808093956448" FRTYPE="0" CLIPEDIT="0" PWIDTH="1.00000017094018" PLINEART="1" TEXTFLOWMODE="1" path="M0 0 L36.8504 0 L36.8504 31.1808 L0 31.1808 L0 0 Z" copath="M0 0 L36.8504 0 L36.8504 31.1808 L0 31.1808 L0 0 Z" gXpos="0" gYpos="-2.33464566929134" gWidth="36.8503937007874" gHeight="32.1811023622047" LAYER="0"/>
        <PAGEOBJECT XPOS="142.520685523925" YPOS="941.575798451778" OwnPage="1" ItemID="551786710" PTYPE="4" WIDTH="31.181107692308" HEIGHT="31.1808093956448" FRTYPE="0" CLIPEDIT="0" PWIDTH="1.00000017094018" PCOLOR="White" PCOLOR2="Black" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L31.1811 0 L31.1811 31.1808 L0 31.1808 L0 0 Z" copath="M0 0 L31.1811 0 L31.1811 31.1808 L0 31.1808 L0 0 Z" gXpos="2.83464566929297" gYpos="-2.33464566929134" gWidth="36.8503937007874" gHeight="32.1811023622047" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONTSIZE="24" CH="4"/>
                <trail PARENT="Number"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="366.457692913388" YPOS="984.095488188971" OwnPage="1" ItemID="551974678" PTYPE="4" WIDTH="286.299212598425" HEIGHT="175.748031496063" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="Cyan" SHADE="10" PCOLOR2="Black" PLINEART="6" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="2.83464566929134" TEXTRA="2.83464566929134" BEXTRA="2.83464566929134" REXTRA="2.83464566929134" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286.299 0 L286.299 175.748 L0 175.748 L0 0 Z" copath="M0 0 L286.299 0 L286.299 175.748 L0 175.748 L0 0 Z" gXpos="961.733283464568" gYpos="102.205724409449" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="gravity = 7"/>
                <para PARENT="New Code"/>
                <ITEXT CH="mass = 5"/>
                <para PARENT="New Code"/>
                <ITEXT CH="required_force = gravity * mass"/>
                <para PARENT="New Code"/>
                <ITEXT CH="print(&quot;Gravity is&quot;, gravity)"/>
                <para PARENT="New Code"/>
                <para PARENT="Code"/>
                <ITEXT CH="for attempt in range(10):"/>
                <para PARENT="Code"/>
                <ITEXT CH="    force = int(input(&quot;Enter launch force: &quot;))"/>
                <para PARENT="New Code"/>
                <ITEXT CH="    if force &lt; required_force:"/>
                <para PARENT="New Code"/>
                <ITEXT CH="        print(&quot;Too low!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="    elif force &gt; required_force:"/>
                <para PARENT="New Code"/>
                <ITEXT CH="        print(&quot;Too high!&quot;)"/>
                <para PARENT="Code"/>
                <ITEXT CH="    else:"/>
                <para PARENT="Code"/>
                <ITEXT CH="        print(&quot;Well done! You took off!&quot;)"/>
                <para PARENT="New Code"/>
                <ITEXT CH="        break"/>
                <trail PARENT="Code"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="250.237220472439" YPOS="1562.36320472441" OwnPage="1" ItemID="552275478" PTYPE="4" WIDTH="399.685039370079" HEIGHT="99.2125984251969" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="Green" SHADE="10" PCOLOR2="Black" PLINEART="15" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="2.83464566929134" TEXTRA="2.83464566929134" BEXTRA="2.83464566929134" REXTRA="2.83464566929134" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L399.685 0 L399.685 99.2126 L0 99.2126 L0 0 Z" copath="M0 0 L399.685 0 L399.685 99.2126 L0 99.2126 L0 0 Z" gXpos="845.512811023623" gYpos="680.473440944884" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="In the 1980s many young people learned to program by typing games from books like "/>
                <ITEXT FONT="Lexend Black" CH="Computer Spacegames"/>
                <ITEXT CH=". This project recreates one of those games in modern Python."/>
                <para PARENT="Paragraph"/>
                <ITEXT CH="The Computer Spacegames book, and various others, can still be found here:"/>
                <para PARENT="Paragraph"/>
                <tab/>
                <ITEXT CH="https://usborne.com/gb/books/computer-and-coding-books"/>
                <para PARENT="Paragraph"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="734.96162992126" YPOS="688.977377952756" OwnPage="0" ItemID="552114486" PTYPE="4" WIDTH="515.905511811024" HEIGHT="62.3622047244095" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR2="Black" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.906 0 L515.906 62.3622 L0 62.3622 L0 0 Z" copath="M0 0 L515.906 0 L515.906 62.3622 L0 62.3622 L0 0 Z" gXpos="734.96162992126" gYpos="688.977377952757" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Lets make the game a bit more interesting:"/>
                <para PARENT="Paragraph"/>
                <ITEXT CH="Tell the player if the guess is too high or too low."/>
                <para PARENT="Bullet"/>
                <ITEXT CH="Give the player 10 chances to get it right."/>
                <para PARENT="Bullet"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="734.961629921258" YPOS="686.142732283466" OwnPage="0" ItemID="552374614" PTYPE="6" WIDTH="36.8503937007874" HEIGHT="31.1811023622047" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" path="M0 0 L36.8504 0 L36.8504 31.1811 L0 31.1811 L0 0 Z" copath="M0 0 L36.8504 0 L36.8504 31.1811 L0 31.1811 L0 0 Z" gXpos="734.961629921258" gYpos="686.142732283466" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="737.796275590551" YPOS="686.142732283466" OwnPage="0" ItemID="552402486" PTYPE="4" WIDTH="31.1811023622047" HEIGHT="31.1811023622047" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="White" PCOLOR2="Black" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L31.1811 0 L31.1811 31.1811 L0 31.1811 L0 0 Z" copath="M0 0 L31.1811 0 L31.1811 31.1811 L0 31.1811 L0 0 Z" gXpos="737.796275590551" gYpos="686.142732283466" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="3"/>
